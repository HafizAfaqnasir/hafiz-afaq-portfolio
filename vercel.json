{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/work/:slug/index.html",
      "destination": "/work/:slug/",
      "statusCode": 301
    },
    {
      "source": "/services/:slug/index.html",
      "destination": "/services/:slug/",
      "statusCode": 301
    },
    {
      "source": "/ip-trademark-regulatory/index.html",
      "destination": "/ip-trademark-regulatory/",
      "statusCode": 301
    },
    {
      "source": "/work/index.html",
      "destination": "/work/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}